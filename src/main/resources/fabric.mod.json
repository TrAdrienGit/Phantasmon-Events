	"authors": [
		"Mystaria"
	],
	"contributors": [
		"Pokémon Reborn team (field data, move table and battle AI adapted, rebornevo.com)"
	],
	"contact": {
		"homepage": "https://github.com/TrAdrienGit/Phantasmon-Events",
		"sources": "https://github.com/TrAdrienGit/Phantasmon-Events",
		"issues": "https://github.com/TrAdrienGit/Phantasmon-Events/issues"
	},
	"license": "Apache-2.0",
	"icon": "assets/phantasmon_events/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.mystaria.events.PhantasmonEvents"
		],
		"voicechat": [
			"com.mystaria.events.trahison.voice.TrahisonVoicePlugin"
		]
	},
	"mixins": [
		"phantasmon_events.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"cobblemon": ">=1.8.1",
		"phantasmon": ">=0.1.66 <0.2.0",
		"cobblemon_battle_showtime": ">=1.7.30 <2.0.0"
